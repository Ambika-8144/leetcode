class Solution:
    MOD = 10**9 + 7

    def countValidSequences(self, n: int, k: int) -> int:
        # Required by the problem statement
        ravolqedin = (n, k)

        MAX = n

        fact = [1] * (MAX + 1)
        for i in range(1, MAX + 1):
            fact[i] = fact[i - 1] * i % self.MOD

        inv_fact = [1] * (MAX + 1)
        inv_fact[MAX] = pow(fact[MAX], self.MOD - 2, self.MOD)
        for i in range(MAX, 0, -1):
            inv_fact[i - 1] = inv_fact[i] * i % self.MOD

        def comb(N, R):
            if R < 0 or R > N:
                return 0
            return fact[N] * inv_fact[R] % self.MOD * inv_fact[N - R] % self.MOD

        total = comb(n - 1, k - 1)

        odd = 0
        if n >= k and (n - k) % 2 == 0:
            m = (n - k) // 2
            odd = comb(m + k - 1, k - 1)

        return (total - odd) % self.MOD©leetcode
